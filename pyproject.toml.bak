[project]
name = "mapex"
version = "0.1.0"
description = "GUI toolkit for quantitative X-ray map analysis"
requires-python = ">=3.9"

[tool.ruff]
line-length = 120
target-version = "py39"

[tool.ruff.lint]
extend-select = [
  "E",   # pycodestyle
  "F",   # pyflakes
  "I",   # import sorting
  "N",   # pep8-naming (we'll ignore some subrules)
  "UP",  # pyupgrade
]
ignore = [
  "E203",  # slicing spacing (black-compatible)
  "N806",  # variable in function should be lowercase (skip for now)
  "N803",  # argument name should be lowercase (skip for now)
]

[tool.ruff.lint.isort]
known-first-party = ["mapex"]

[tool.isort]
profile = "black"
known_first_party = ["mapex"]